# Robinhood credentials
RH_USERNAME=your_email@example.com
RH_PASSWORD=your_password
# If you have MFA enabled (recommended), put your TOTP secret key here
# Get this from Robinhood > Account > Security > Two-Factor Authentication > Authenticator App
# Copy the "secret key" shown during setup (not the 6-digit code)
RH_MFA_SECRET=

# Bot behavior
# DRY_RUN=true means the bot will log trades but never actually place orders
DRY_RUN=true

# Optional: comma-separated list of tickers to always include in scans
WATCHLIST=

# Optional: override log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
